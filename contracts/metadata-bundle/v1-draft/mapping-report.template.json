      "parent_link_rule": "<actual FK/UUID relationship>",
      "evidence": "<schema/code path and line or approved description>"
    }
  ],
  "field_mappings": [
    {
      "source_path": "<table.field or JSON path>",
      "public_path": "<e.g. epochs[].fields.lab:amplitude>",
      "public_field_id": "<namespaced ID>",
      "declared_type": "<number/integer/integer_string/decimal/string/boolean/array/object>",
      "scope": "<source/cell/epoch/protocol/ancestry>",
