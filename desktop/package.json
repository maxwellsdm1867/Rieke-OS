{
  "name": "rieke-os-desktop",
  "version": "0.1.3",
  "private": true,
  "description": "Rieke OS self-contained desktop application",
  "author": "Rieke OS contributors",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs test/*.test.cjs",
    "test:e2e": "node e2e/packaged.e2e.cjs",
    "test:e2e:startup-failure": "node e2e/backend-failure.e2e.cjs",
    "test:e2e:updater": "electron tests/e2e/updater-client.cjs",
    "pack": "electron-builder --mac --arm64 --dir",
    "dist": "electron-builder --mac dmg zip --arm64 --publish never",
    "test:e2e:bootstrap": "node e2e/bootstrap.e2e.cjs",
    "test:e2e:github-updates": "node e2e/github-updates.e2e.cjs"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "44.5.0",
    "electron-builder": "26.15.3",
    "playwright": "1.63.0"
  },
  "build": {
    "appId": "org.riekeos.desktop",
    "productName": "Rieke OS",
    "artifactName": "Rieke-OS-${version}-${arch}.${ext}",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "*.cjs",
      "*.html",
      "*.css",
      "recovery.js",
      "icon.png",
      "package.json",
      "distribution.json"
    ],
    "extraResources": [
      {
        "from": "build/runtime",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "icon": "icon.png",
      "minimumSystemVersion": "14.0",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "notarize": true,
      "sign": "./sign-runtime.cjs"
    },
    "dmg": {
      "sign": false,
      "title": "Open Rieke OS to install",
      "backgroundColor": "#f7f4fa",
      "window": {
        "width": 560,
        "height": 400
      },
      "contents": [
        {
          "x": 280,
          "y": 180,
          "type": "file",
          "name": "Rieke OS.app"
        }
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "maxwellsdm1867",
      "repo": "Rieke-OS",
      "releaseType": "draft"
    },
    "afterPack": "./seal-testing.cjs"
  }
}
