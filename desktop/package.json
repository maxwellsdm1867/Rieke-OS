{
  "name": "disco-desktop",
  "version": "0.1.7",
  "private": true,
  "description": "Disco self-contained desktop application",
  "author": "Disco contributors",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs test/*.test.cjs",
    "test:e2e": "node e2e/packaged.e2e.cjs",
    "test:e2e:smoke": "node e2e/smoke.e2e.cjs",
    "test:e2e:startup-failure": "node e2e/backend-failure.e2e.cjs",
    "test:e2e:updater": "electron tests/e2e/updater-client.cjs",
    "pack": "electron-builder --mac --arm64 --dir",
    "pack:preview": "electron-builder --config preview-builder.cjs --mac --arm64 --dir --publish never",
    "dist": "electron-builder --mac dmg zip --arm64 --publish never",
    "test:e2e:bootstrap": "node e2e/bootstrap.e2e.cjs",
    "test:e2e:github-updates": "node e2e/github-updates.e2e.cjs",
    "test:e2e:branding": "node e2e/branding-browser.e2e.cjs"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "44.5.0",
    "electron-builder": "26.15.3",
    "playwright": "1.63.0"
  },
  "build": {
    "appId": "org.riekeos.desktop",
    "productName": "Disco",
    "artifactName": "Disco-${version}-${arch}.${ext}",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "*.cjs",
      "*.html",
      "*.css",
      "recovery.js",
      "icon.png",
      "package.json",
      "distribution.json",
      "rieke-emblem.png"
    ],
    "extraResources": [
      {
        "from": "build/runtime",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "icon": "icon.png",
      "minimumSystemVersion": "14.0",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "notarize": true,
      "sign": "./sign-runtime.cjs",
      "extendInfo": {
        "CFBundleDisplayName": "Disco",
        "CFBundleName": "Disco"
      },
      "executableName": "Disco"
    },
    "dmg": {
      "sign": false,
      "title": "Open Disco to install",
      "backgroundColor": "#f7f4fa",
      "window": {
        "width": 560,
        "height": 400
      },
      "contents": [
        {
          "x": 280,
          "y": 180,
          "type": "file",
          "name": "Disco.app"
        }
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "maxwellsdm1867",
      "repo": "Rieke-OS",
      "releaseType": "draft"
    },
    "afterPack": "./seal-testing.cjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/maxwellsdm1867/Rieke-OS.git"
  },
  "homepage": "https://github.com/maxwellsdm1867/Rieke-OS",
  "bugs": {
    "url": "https://github.com/maxwellsdm1867/Rieke-OS/issues"
  }
}
