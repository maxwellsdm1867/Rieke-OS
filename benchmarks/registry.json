  "gaps": [
    {
      "id": "db.fields.complete",
      "reason": "Current eligible-field oracle excludes some deep paths, long arrays/strings and ticks. Independent all-raw-field inventory required; all fields must remain accessible regardless acceleration tier."
    },
    {
      "id": "db.fields.fallback",
      "reason": "Tier promotion/demotion with exact membership/order/types/units and slow correct fallback not implemented."
    },
    {
      "id": "db.fields.incomplete",
      "reason": "Explicit unavailable/extraction-incomplete semantics for arbitrary raw fields not implemented; never infer empty success."
    },
    {
      "id": "db.adaptive.workload",
      "reason": "Design only: compare static, instrumented-fixed, adaptive, manually tuned; count telemetry/build/refresh/contention cost."
    },
    {
