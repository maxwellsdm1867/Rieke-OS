  "release_requirements": [
    {
      "id": "ui.native.navigation",
      "status": "unsupported",
      "reason": "Owned native fixture launch and independent rendered authority adapter are not yet integrated. Mounted timings do not prove scroll/layout restoration, trace drawing, native latency or zero H5 reads."
    },
    {
      "id": "db.native.tag_latency",
      "status": "unsupported",
      "reason": "Transactional doubles prove correctness only; no owned native MySQL timing fixture in this core."
    },
    {
      "id": "db.ingest.throughput",
      "status": "unsupported",
      "reason": "Small H5 parsing/import identity tests are correctness only, not end-to-end native ingestion throughput."
    }
  ],
  "gaps": [
    {
      "id": "db.fields.complete",
      "reason": "Current eligible-field oracle excludes some deep paths, long arrays/strings and ticks. Independent all-raw-field inventory required; all fields must remain accessible regardless acceleration tier."
    },
    {
      "id": "db.fields.fallback",
      "reason": "Tier promotion/demotion with exact membership/order/types/units and slow correct fallback not implemented."
    },
    {
      "id": "db.fields.incomplete",
      "reason": "Explicit unavailable/extraction-incomplete semantics for arbitrary raw fields not implemented; never infer empty success."
    },
    {
      "id": "db.adaptive.workload",
      "reason": "Design only: compare static, instrumented-fixed, adaptive, manually tuned; count telemetry/build/refresh/contention cost."
    },
    {
      "id": "db.adaptive.shift-budget",
      "reason": "Design only: workload shift, rare export, updates, deduplication, hysteresis, cooldown, manual pins."
    },
    {
      "id": "db.adaptive.publish-fault",
      "reason": "Design only: cancellation/crash/revision/partial-publication refusal."
    },
    {
      "id": "db.import.general_json",
      "reason": "Generalized metadata JSON importer not implemented."
    },
    {
      "id": "db.export.metadata_vnext_attach_traces",
      "reason": "Metadata-only export vNext and Attach Traces not implemented. Current SQLite export has source pointers, not portable raw data."
    },
    {
      "id": "db.stress.scale",
      "reason": "Core is 12 sealed metadata records and 500 mocked frontend rows, not representative large acquisition scale; separate stress plan applies."
    }
  ],
