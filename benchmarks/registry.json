      "reason": "Owned native fixture launch and independent rendered authority adapter are not yet integrated. Mounted timings do not prove scroll/layout restoration, trace drawing, native latency or zero H5 reads."
    },
    {
      "id": "db.native.tag_latency",
      "status": "unsupported",
      "reason": "Transactional doubles prove correctness only; no owned native MySQL timing fixture in this core."
