{
  "format": "disco-adopted-port-checks",
  "version": 1,
  "discovery": [
    {"from": "AGENTS.md", "to": "ARCHITECTURE.md"},
    {"from": "ARCHITECTURE.md", "to": "docs/architecture/0.1.8-first-port-slices.md"},
    {"from": "ARCHITECTURE.md", "to": "docs/architecture/adopted-port-checks.json"},
    {"from": "docs/architecture/0.1.8-first-port-slices.md", "to": "docs/architecture/stable-ports.md"},
    {"from": "docs/architecture/0.1.8-first-port-slices.md", "to": "docs/architecture/adopted-port-checks.json"}
  ],
  "shared_paths": [
    "AGENTS.md", "ARCHITECTURE.md", "docs/architecture/**",
    "tools/architecture_guard.py", "python/tests/test_architecture_guard.py",
    "workspace-app/architectureImports.mjs", "workspace-app/src/architectureImports.test.js",
    ".github/workflows/**", "rieke-release.json", "python/rieke-release.json",
    "desktop/package.json", "desktop/package-lock.json", "desktop/application-profile.json"
  ],
  "contracts": [
    {
      "id": "p03-selection-reader",
      "contract": {"path": "docs/architecture/0.1.8-first-port-slices.md", "heading": "Tree selection reader"},
      "affected_paths": ["workspace-app/**"],
      "rules": [
        {
          "language": "javascript",
          "file": "workspace-app/src/components/PagedTree.jsx",
          "deny": ["workspace-app/src/api.js", "workspace-app/src/pagedTreeRequest.js", "workspace-app/src/treeBranchReadCache.js", "node:module", "module"],
          "require": ["workspace-app/src/treeSelectionReader.js"]
        },
        {
          "language": "javascript",
          "file": "workspace-app/src/treeSelectionReader.js",
          "allow": ["workspace-app/src/api.js", "workspace-app/src/pagedTreeRequest.js"]
        }
      ],
      "tests": {
        "javascript": ["workspace-app/src/treeSelectionReader.test.js", "workspace-app/src/pagedTreeLifecycle.test.js", "workspace-app/src/pagedTreeRequest.test.js", "workspace-app/src/inspectorTreeAuthority.test.js", "workspace-app/src/stableContentInert.test.js", "workspace-app/src/candidateContinuity.test.js"],
        "python": []
      }
    },
    {
      "id": "p04-mutation-recovery",
      "contract": {"path": "docs/architecture/0.1.8-first-port-slices.md", "heading": "Mutation recovery completion"},
      "affected_paths": ["python/**", "workspace-app/**"],
      "rules": [
        {"language": "python", "file": "python/workspace_mutation_outcomes.py", "allow": ["flask"]}
      ],
      "tests": {
        "javascript": ["workspace-app/src/apiCommandPolicy.test.js", "workspace-app/src/desktopLifecycle.test.js", "workspace-app/src/projectUnmount.test.js"],
        "python": ["python/tests/test_workspace_mutation_outcomes.py", "python/tests/test_workspace_group_recovery.py", "python/tests/test_workspace_registered_recovery_policy.py"]
      }
    },
    {
      "id": "p05-export-materialization",
      "contract": {"path": "docs/architecture/0.1.8-first-port-slices.md", "heading": "Export format materialization"},
      "affected_paths": ["python/**"],
      "rules": [
        {"language": "python", "file": "python/workspace_export_artifacts.py", "allow": ["pathlib", "workspace_sqlite", "workspace_external_tags"]},
        {"language": "python", "file": "python/workspace_api.py", "require": ["workspace_export_artifacts"], "deny": ["workspace_sqlite"]},
        {"language": "python", "file": "python/workspace_candidate_exports.py", "require": ["workspace_export_artifacts"], "deny": ["workspace_sqlite", "workspace_external_tags"]}
      ],
      "tests": {
        "javascript": [],
        "python": ["python/tests/test_workspace_export_artifacts.py", "python/tests/test_workspace_export_boundary.py", "python/tests/test_workspace_candidate_exports.py", "python/tests/test_workspace_export_boundaries.py", "python/tests/test_workspace_export_paths.py", "python/tests/test_workspace_recipes.py", "python/tests/test_workspace_sqlite.py", "python/tests/test_workspace_matlab.py", "python/tests/test_workspace_export_reader.py", "python/tests/test_workspace_workbench_exports.py"]
      }
    },
    {
      "id": "p07-runtime-lifecycle",
      "contract": {
        "path": "docs/architecture/0.1.8-first-port-slices.md",
        "heading": "Project runtime lifecycle obligations"
      },
      "affected_paths": [
        "desktop/**",
        "workspace-app/**",
        "python/**",
        "docs/dev/DESKTOP_QUIT_COORDINATION.md"
      ],
      "rules": [
        {
          "language": "javascript",
          "file": "desktop/quit-coordinator.cjs",
          "allow": []
        },
        {
          "language": "javascript",
          "file": "desktop/draft-barrier.cjs",
          "allow": [
            "node:crypto"
          ]
        },
        {
          "language": "javascript",
          "file": "workspace-app/src/desktopLifecycle.js",
          "allow": []
        }
      ],
      "tests": {
        "javascript": [
          "workspace-app/src/desktopLifecycle.test.js",
          "workspace-app/src/projectUnmount.test.js",
          "workspace-app/src/apiCommandPolicy.test.js",
          "workspace-app/src/desktopDraftSession.test.js",
          "workspace-app/src/startupRestore.test.js"
        ],
        "python": [
          "python/tests/test_workspace_desktop.py",
          "python/tests/test_workspace_lifecycle.py",
          "python/tests/test_workspace_startup_registry.py",
          "python/tests/test_workspace_startup.py",
          "python/tests/test_lazy_startup_outcome.py"
        ],
        "desktop": [
          "desktop/tests/supervisor.test.cjs",
          "desktop/tests/draft-barrier.test.cjs",
          "desktop/tests/draft-store.test.cjs",
          "desktop/tests/quit-coordinator.test.cjs",
          "desktop/tests/main-quit-recovery.test.cjs",
          "desktop/tests/startup-session.test.cjs",
          "desktop/tests/verification-recovery.test.cjs",
          "desktop/tests/main-startup-restoration.test.cjs"
        ]
      }
    }
  ]
}
